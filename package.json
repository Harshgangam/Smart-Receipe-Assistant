{
  "name": "ai-pantry-recipe-assistant-root",
  "private": true,
  "version": "1.0.0",
  "description": "AI-Powered Pantry Intelligence and Food Rescue Assistant - Full-Stack Application",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" \"npm run backend\" \"npm run frontend\"",
    "frontend": "node scripts/start-frontend.js",
    "backend": "node scripts/start-backend.js",
    "build": "npm --prefix frontend run build",
    "test": "concurrently -n \"TEST:BACKEND,TEST:FRONTEND\" -c \"yellow.bold,blue.bold\" \"npm run test:backend\" \"npm run test:frontend\"",
    "test:backend": "python -m pytest backend/tests",
    "test:frontend": "npm --prefix frontend run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "jsdom": "^29.1.1"
  }
}
