# ==============================================================================
# AI-Powered Pantry Recipe Assistant — Environment Configuration
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Recommendation Engine Scoring Weights (Milestone 2)
IMS_WEIGHT=0.6
PUS_WEIGHT=0.4
DEFAULT_RECOMMENDATION_LIMIT=10
MAX_RECOMMENDATION_LIMIT=100
CANDIDATE_POOL_LIMIT=150

# Personalization Preferences (Milestone 3)
CUISINE_BONUS_HIGH_CONFIDENCE=15.0
CUISINE_BONUS_MEDIUM_CONFIDENCE=10.0
TIME_BONUS_MAX=10.0
TIME_PENALTY_RATE=0.2
TIME_PENALTY_MAX=15.0

# ==============================================================================
# Milestone 6: AI-Assisted Grounded Recipe Guidance / Structured RAG Layer
# ==============================================================================
# LLM Provider: "gemini" (recommended), "openai", or "mock" (offline fallback)
# If LLM_API_KEY is left empty, the application automatically runs using the
# deterministic, rule-grounded MockLLMClient (zero cost, 100% offline).
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here

LLM_MODEL=gemini-3.5-flash
# Optional: Base URL for OpenAI-compatible providers (e.g. Groq, local vLLM, Ollama)
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=600

# ==============================================================================
# RAG Pipeline (src/ folder — ChromaDB + Groq)
# ==============================================================================
# ChromaDB: where vector data is stored on disk
CHROMA_DB_PATH=./data/chroma_db
# ChromaDB: collection name for pantry/recipe chunks
CHROMA_COLLECTION=pantry_recipes
# Groq API key for llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here
